# Server Configuration
PORT=8080

# Security & Authentication
JWT_SECRET=whyline-dev-super-secret-jwt-token-key-2026
JWT_EXPIRY=24h
ADMIN_SECRET=whyline-admin-secret-2026

# ------------------------------------------------------------------------------
# FalkorDB Graph Database Configuration
# ------------------------------------------------------------------------------
# Option A: FalkorDB Cloud (Endpoint format)
# FALKORDB_ENDPOINT=r-xxxxxx.instance-xxxx.ap-south-1.aws.f2e0a955bb84.cloud:63967

# Option B: Host & Port format (Local Docker or Cloud)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Authentication (FalkorDB ACL)
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Graph Name (default: company)
FALKORDB_GRAPH=company

# Set true if your FalkorDB provider requires SSL/TLS (set false for plain TCP / local Docker)
FALKORDB_TLS=false

# ------------------------------------------------------------------------------
# Web & API Gateway
# ------------------------------------------------------------------------------
# Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# Google Gemini AI (Neural Reasoning & Vector Embeddings)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Email Verification (Gmail SMTP for Registration OTP)
# ------------------------------------------------------------------------------
APP_EMAIL=your_email@gmail.com
APP_PASSWORD=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
OTP_EXPIRY=10m
